# Copy to .env and fill in. .env is git-ignored.
# Browser key: restrict it to your site's referrers (e.g. http://localhost:4173/*) and to
# Maps JavaScript, Air Quality, Weather, Places (New), Geocoding (and Map Tiles for 3D).
GOOGLE_MAPS_API_KEY=""
# Optional — a Map ID from Cloud Console (Map Management). Leave empty to use DEMO_MAP_ID.
GOOGLE_MAPS_MAP_ID=""
# AI chat (server-side only, never sent to the browser). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
